<Project>
    <!--
        Goldenglow API compatibility defines.

        Generates cumulative STS2_AT_LEAST_<ver> symbols based on the active
        Sts2ApiCompat value. Each symbol means "the host API is at least this version".

        Usage in source:
            #if STS2_AT_LEAST_109_0
            // new API path (0.109.0+)
            #else
            // legacy API path (0.107.1)
            #endif

        Adding a new supported version:
        - append it to _GoldenglowSupportedApiVersions
        - add a DefineConstants entry for the new STS2_AT_LEAST_* symbol
    -->

    <PropertyGroup>
        <_GoldenglowSupportedApiVersions>0.107.1;0.109.0</_GoldenglowSupportedApiVersions>
        <_GoldenglowSupportedApiList>|0.107.1|0.109.0|</_GoldenglowSupportedApiList>
    </PropertyGroup>

    <PropertyGroup>
        <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(Sts2ApiCompat)', '0.109.0'))">$(DefineConstants);STS2_AT_LEAST_109_0</DefineConstants>
    </PropertyGroup>

    <Target Name="ValidateGoldenglowCompatTarget" BeforeTargets="CoreCompile">
        <Error
            Condition="'$(Sts2ApiCompat)' == '' or !$(_GoldenglowSupportedApiList.Contains('|$(Sts2ApiCompat)|'))"
            Text="Sts2ApiCompat='$(Sts2ApiCompat)' is not in the supported set ($(_GoldenglowSupportedApiVersions)). Update build\Goldenglow.CompatDefines.targets to add the new version and a corresponding STS2_AT_LEAST_* define."/>
    </Target>
</Project>
