[sub_resource type="Shader" id="Shader_gg2mq"]
code = "shader_type canvas_item;

// 暴露给外部的参数
uniform vec2 iResolution = vec2(800.0, 800.0);
uniform float speed = 1.1;
uniform float brightness = 1.3;
uniform vec3 innerBgColor = vec3(0.0125, 0.0, 0.025);
uniform float innerBgAlpha = 1.0;
uniform vec3 boltHueShift = vec3(0.0, 0.0, 0.0);
uniform vec3 reflectColor1 = vec3(0.12, 0.12, 0.5);
uniform vec3 reflectColor2 = vec3(0.55, 0.2, 0.55);
uniform float rayCount = 13.0;
uniform float rayThickness = 0.011;
const float NUM_RAYS = 13.0;
const int VOLUMETRIC_STEPS = 19;
const int MAX_ITER = 35;
const float FAR = 6.0;

// 旋转矩阵
const mat3 m3 = mat3(
	vec3( 0.00,  0.80,  0.60),
	vec3(-0.80,  0.36, -0.48),
	vec3(-0.60, -0.48,  0.64)
);

// 基础哈希与噪声函数
float hash(float n) {
	return fract(sin(n) * 43758.5453);
}

float hash21(vec2 p) {
	p = fract(p * vec2(234.34, 435.345));
	p += dot(p, p + 19.19);
	return fract(p.x * p.y);
}

float noise1D(float x) {
	float sx = x * 0.01;
	float i = floor(sx);
	float f = fract(sx);
	float u = f * f * (3.0 - 2.0 * f);
	return mix(hash(i), hash(i + 1.0), u);
}

float noise2D(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float a = hash21(i);
	float b = hash21(i + vec2(1.0, 0.0));
	float c = hash21(i + vec2(0.0, 1.0));
	float d = hash21(i + vec2(1.0, 1.0));
	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float noise3D(vec3 p) {
	vec3 ip = floor(p);
	vec3 fp = fract(p);
	fp = fp * fp * (3.0 - 2.0 * fp);
	
	vec2 uv = ip.xy + vec2(37.0, 17.0) * ip.z + fp.xy;
	float n0 = noise2D(uv);
	float n1 = noise2D(uv + vec2(0.5));
	return mix(n0, n1, fp.z);
}

mat2 mm2(float a) {
	float c = cos(a);
	float s = sin(a);
	return mat2(vec2(c, -s), vec2(s, c));
}

float flow(vec3 p, float t, float time_val) {
	float z = 2.0;
	float rz = 0.0;
	vec3 bp = p;
	for (float i = 1.0; i < 5.0; i++) {
		p += time_val * 0.1;
		rz += (sin(noise3D(p + t * 0.8) * 6.0) * 0.5 + 0.5) / z;
		p = mix(bp, p, 0.6);
		z *= 2.0;
		p *= 2.01;
		p = p * m3;
	}
	return rz;	
}

float sins(float x, float time_val) {
	float rz = 0.0;
	float z = 2.0;
	for (float i = 0.0; i < 3.0; i++) {
		rz += abs(fract(x * 1.4) - 0.5) / z;
		x *= 1.3;
		z *= 1.15;
		x -= time_val * 0.65 * z;
	}
	return rz;
}

float segm(vec3 p, vec3 a, vec3 b) {
	vec3 pa = p - a;
	vec3 ba = b - a;
	float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);	
	return length(pa - ba * h) * 0.5;
}

vec3 path(float i, float d, float time_val) {
	vec3 en = vec3(0.0, 0.0, 1.0);
	float sns2 = sins(d + i * 0.5, time_val) * 0.22;
	float sns = sins(d + i * 0.6, time_val) * 0.21;
	en.xz = en.xz * mm2((hash(i * 10.569) - 0.5) * 6.2 + sns2);
	en.xy = en.xy * mm2((hash(i * 4.732) - 0.5) * 6.2 + sns);
	return en;
}

vec2 map(vec3 p, float i, float time_val) {
	float lp = length(p);
	vec3 bg = vec3(0.0);   
	vec3 en = path(i, lp, time_val);
	
	float ins = smoothstep(0.11, 0.46, lp);
	float outs = 0.15 + smoothstep(0.0, 0.15, abs(lp - 1.0));
	p *= ins * outs;
	float id = ins * outs;
	
	float rz = segm(p, bg, en) - rayThickness;
	return vec2(rz, id);
}

float march(vec3 ro, vec3 rd, float startf, float maxd, float j, float time_val) {
	float precis = 0.001;
	float h = 0.5;
	float d = startf;
	for (int i = 0; i < MAX_ITER; i++) {
		if (abs(h) < precis || d > maxd) break;
		d += h * 1.2;
		float res = map(ro + rd * d, j, time_val).x;
		h = res;
	}
	return d;
}

vec3 vmarch(vec3 ro, vec3 rd, float j, vec3 orig, float time_val) {   
	vec3 p = ro;
	vec2 r = vec2(0.0);
	vec3 sum = vec3(0.0);
	for (int i = 0; i < VOLUMETRIC_STEPS; i++) {
		r = map(p, j, time_val);
		p += rd * 0.03;
		float lp = length(p);
		
		vec3 col = sin((vec3(1.05, 2.5, 1.52) + boltHueShift) * 3.94 + r.y) * 0.85 + 0.4;
		col.rgb *= smoothstep(0.0, rayThickness * 1.4, -r.x);
		col *= smoothstep(0.04, 0.2, abs(lp - 1.1));
		col *= smoothstep(0.1, 0.34, lp);
		sum += abs(col) * 5.0 * (1.2 - noise1D(lp * 2.0 + j * 13.0 + time_val * 5.0) * 1.1) / (log(distance(p, orig) - 2.0) + 0.75);
	}
	return sum;
}

vec2 iSphere2(vec3 ro, vec3 rd) {
	vec3 oc = ro;
	float b = dot(oc, rd);
	float c = dot(oc, oc) - 1.0;
	float h = b * b - c;
	if (h < 0.0) return vec2(-1.0);
	else return vec2((-b - sqrt(h)), (-b + sqrt(h)));
}

void fragment() {
	// 将渲染范围映射到以中心为原点的 UV 坐标
	vec2 p = UV - 0.5;
	p.x *= iResolution.x / iResolution.y;
	
	float time_val = TIME * speed;
	
	// 相机定义
	vec3 ro = vec3(0.0, 0.0, 5.0);
	vec3 rd = normalize(vec3(p * 0.7, -1.5));
	
	// 自动旋转视口
	mat2 mx = mm2(time_val * 0.4);
	mat2 my = mm2(time_val * 0.3);
	ro.xz = ro.xz * mx;
	rd.xz = rd.xz * mx;
	ro.xy = ro.xy * my;
	rd.xy = rd.xy * my;
	
	vec3 bro = ro;
	vec3 brd = rd;
	
	vec3 col = innerBgColor;
	
	// 渲染闪电光束
	for (float j = 1.0; j < NUM_RAYS + 1.0; j++) {
		if (j > rayCount) continue;
		ro = bro;
		rd = brd;
		mat2 mm = mm2((time_val * 0.1 + ((j + 1.0) * 5.1)) * j * 0.25);
		ro.xy = ro.xy * mm;
		rd.xy = rd.xy * mm;
		ro.xz = ro.xz * mm;
		rd.xz = rd.xz * mm;
		float rz = march(ro, rd, 2.5, FAR, j, time_val);
		if (rz >= FAR) continue;
		vec3 pos = ro + rz * rd;
		col = max(col, vmarch(pos, rd, j, bro, time_val));
	}
	
	// 渲染球体玻璃外壳
	ro = bro;
	rd = brd;
	vec2 sph = iSphere2(ro, rd);

	vec3 boltCol = col;  // 纯闪电层，不含反射
	
	if (sph.x > 0.0) {
		vec3 pos = ro + rd * sph.x;
		vec3 pos2 = ro + rd * sph.y;
		vec3 rf = reflect(rd, pos);
		vec3 rf2 = reflect(rd, pos2);
		float nz = (-log(abs(flow(rf * 1.2, time_val, time_val) - 0.01)));
		float nz2 = (-log(abs(flow(rf2 * 1.2, -time_val, time_val) - 0.01)));
		col += (0.1 * nz * nz * reflectColor1 + 0.05 * nz2 * nz2 * reflectColor2) * 0.8;
	}
	
	if (sph.x < 0.0) {
		COLOR = vec4(0.0, 0.0, 0.0, 0.0);
	} else {
		float hasBolt = max(max(boltCol.r - innerBgColor.r, boltCol.g - innerBgColor.g), boltCol.b - innerBgColor.b);
		float alpha = mix(innerBgAlpha, 1.0, smoothstep(0.0, 0.005, hasBolt));
		COLOR = vec4(col * brightness, alpha);
	}
}"

