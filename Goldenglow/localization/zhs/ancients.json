{
  "DARV.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.char": "哇……这里的东西堆得比理发室的储物柜还满呢。",
  "DARV.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.next": "继续",
  "DARV.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-1.ancient": "来来，小猫咪，别客气！随便挑一块去吧！！",
  "DARV.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-0r.ancient": "又来翻我的宝贝啦？慢慢挑！！",
  "DARV.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.ancient": "我这里有无数亮闪闪的玩意儿……可没见着你在找的那一件啊。",
  "DARV.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.next": "回应",
  "DARV.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.char": "没关系的……亮闪闪的东西让我想起老爹店里的灯。谢谢您。",
  "DARV.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.next": "继续",
  "DARV.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-2.ancient": "嗨呀，别这么见外！拿去拿去，我这儿多的是！！",

  "NEOW.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.char": "妮芙小姐叫我来帮忙……但是这是哪里呀？",
  "NEOW.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.next": "继续",
  "NEOW.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-1.ancient": "[sine]...异界...女孩...帮助我.....[/sine]",
  "NEOW.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-0r.ancient": "[sine]...放电的...小姑娘...\n...需要...帮助...[/sine]",
  "NEOW.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.ancient": "[sine]...你..还缺...什么...？[/sine]",
  "NEOW.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.char": "我的源石技艺还不够精湛……我需要多加练习。",
  "NEOW.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.next": "继续",
  "NEOW.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.ancient": "[sine]...我还会...在...这个地方...还在.....[/sine]",

  "NONUPEIPE.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.char": "漂亮的女士，你知道怎么离开这个地方吗？",
  "NONUPEIPE.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.next": "继续",
  "NONUPEIPE.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-1.ancient": "哎呀，甜美的女孩。你在找什么呢？我可以帮你打扮得更漂亮。",
  "NONUPEIPE.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-0r.ancient": "快过来，让我把你打扮得更加光彩耀人。",
  "NONUPEIPE.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.char": "女士，您比我们维多利亚的贵族还要优雅！",
  "NONUPEIPE.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.next": "赞美",
  "NONUPEIPE.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.ancient": "我早已知晓。来吧，来挑一件诚实者的礼物吧。",

  "OROBAS.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.char": "哎呀，大眼先生，您吓了我一跳！",
  "OROBAS.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.next": "继续",
  "OROBAS.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-1.ancient": "小动物！？哪里来的！",
  "OROBAS.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-0r.ancient": "闪电闪电！！我最喜欢放电的生物啦！！",
  "OROBAS.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.ancient": "闪电姑娘！！再给我讲讲你的故事吧！！",
  "OROBAS.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.next": "讲述",
  "OROBAS.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.char": "[i][font_size=22]澄闪耐心的讲述泰拉大陆的故事[/font_size][/i]",
  "OROBAS.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.next": "继续",
  "OROBAS.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-2.ancient": "神奇神奇！！我也想去泰拉大陆看看！！",

  "PAEL.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.char": "（她是一条龙？不要吵醒她，快走吧。）",
  "PAEL.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.next": "继续",
  "PAEL.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-1.ancient": "[thinky_dots]安静的旅人……拿走我的一部分……[/thinky_dots]",
  "PAEL.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-0r.ancient": "[thinky_dots]不要心急……你也可以和我一样……在安静中寻找属于自己的光亮……[/thinky_dots]",
  "PAEL.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.ancient": "[thinky_dots]我的血肉会帮助你……善良的女孩……[/thinky_dots]",
  "PAEL.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.next": "感谢",
  "PAEL.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.char": "谢谢你。你让我在这不再孤单。",
  "PAEL.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.next": "继续",
  "PAEL.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-2.ancient": "[thinky_dots]收下吧……[/thinky_dots]",

  "TANX.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.char": "狮子先生！我真不能和你战斗了！",
  "TANX.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.next": "继续",
  "TANX.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-1.ancient": "[b]不行！！拿着这把武器！[/b]",
  "TANX.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-0r.ancient": "[b]你的弱点是自身！！加强防御，更加坚强！！[/b]",
  "TANX.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.ancient": "[b]与我一战，这就是你现在的命运！！[/b]",
  "TANX.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.next": "退让",
  "TANX.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.char": "我还有更重要的事……大家在等着我。",
  "TANX.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.next": "继续",
  "TANX.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-2.ancient": "[b]懦弱！！但我已尽兴！！收下这把武器！[/b]",

  "TEZCATARA.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.char": "唔……好暖和，我不打扰您吧？",
  "TEZCATARA.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.next": "继续",
  "TEZCATARA.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-1.ancient": "让人怜爱的孩子。进来[jitter][b]温暖[/b][/jitter]一下吧，别老炸着毛。",
  "TEZCATARA.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-0r.ancient": "又来啦？让我把你那点[jitter][b]静电[/b][/jitter]也一起烧干净，好不好呀？",
  "TEZCATARA.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.ancient": "亲爱的，尝尝我给你做的[jitter][b]点心[/b][/jitter]吧。",
  "TEZCATARA.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.next": "推辞",
  "TEZCATARA.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.char": "……谢谢您。不过源石技艺和火靠太近，我怕把自己烫着。我还是站着就好。",
  "TEZCATARA.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.next": "继续",
  "TEZCATARA.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-2.ancient": "哎呀，真是个[jitter][b]乖巧[/b][/jitter]的孩子。那就收下这个吧，小心别烫着。",

  "VAKUU.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.char": "那个……恶魔先生也做交易吗？我、我只会理发……",
  "VAKUU.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0.next": "继续",
  "VAKUU.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-1.ancient": "不值钱的[sine]手艺[/sine]积攒起来，也是很可观的呢……",
  "VAKUU.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-0r.ancient": "你又来啦。这次想用[sine]什么[/sine]换什么呢？你的静电？还是你那根法杖？",
  "VAKUU.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.ancient": "代价是你[sine]永远留在这里[/sine]……\n你签么？",
  "VAKUU.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0.next": "回应",
  "VAKUU.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.char": "……我不要永远。我只想回应你们的期待，然后回去找大家。",
  "VAKUU.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1.next": "继续",
  "VAKUU.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-2.ancient": "拿走吧。这份契约我[sine]替你留着[/sine]。",

  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0r.ancient": "你是怎么爬到这儿的？",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-0r.next": "回答",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-1r.char": "我……是来帮大家的。妮芙小姐说，这里需要我。",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-1r.next": "继续",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.0-2r.ancient": "真奇怪。",
  "THE_ARCHITECT.talk.TEST_CHARACTER.0-attack": "Both",

  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-0r.ancient": "又回来了。你以为重复几次，结果就会不同？",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-0r.next": "继续",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-1r.char": "唔……也许吧。但学一门手艺就要多练。\n我多试几次，总会对的。",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-1r.next": "继续",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.1-2r.ancient": "真是顽固。",
  "THE_ARCHITECT.talk.TEST_CHARACTER.1-attack": "Both",

  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0r.ancient": "回去吧。我不需要你给我理发。",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-0r.next": "继续",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1r.char": "……大家也都在等我。我不能现在就走。",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-1r.next": "继续",
  "THE_ARCHITECT.talk.GOLDENGLOW_CHARACTER_GOLDENGLOW.2-2r.ancient": "别说我没提醒过你。",
  "THE_ARCHITECT.talk.TEST_CHARACTER.2-attack": "Both"
}
